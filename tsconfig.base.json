{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "paths": {
      "@autotests-simulator/sim-kit": ["./packages/sim-kit/src/index.ts"],
      "@autotests-simulator/config": ["./packages/config/src/index.ts"],
      "@autotests-simulator/domain": ["./packages/domain/src/index.ts"],
      "@autotests-simulator/ui": ["./packages/ui/src/index.ts"],
      "@autotests-simulator/ui/*": ["./packages/ui/src/*"]
    }
  }
}
